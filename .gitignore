.DS_Store
/.build
/Packages
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc
.env
/dist/
sparkle_private_key.pem
*sparkle*private*.pem
extension-key.pem

# Local agent worktrees and generated launch media.
/.claude/
/media/
/launch-video/

# Remove root files and project metadata from tracking
/*
!.gitignore
!/Package.swift
!/README.md
!/.github/
!/.github/SECURITY.md
!/scripts/
!/scripts/release.sh
!/Sources/
!/Tests/
!/.agents/
!/extension/
!/ios/

# Generated by `xcodegen generate`, which scripts/build-ios.sh runs on every
# build — ios/project.yml is the source of truth, so a tracked copy would be
# overwritten constantly and only produce pbxproj merge conflicts.
/ios/FastTabMobile.xcodeproj/
# Xcode derived data for the iOS target (DERIVED_DATA="build" in build-ios.sh).
/ios/build/
# Xcode derived data for iOS Simulator builds.
/ios/build-sim/
# Xcode derived data for ad-hoc build checks.
/ios/build-check/
# xcodebuild / simulator run logs.
/ios/*.log
# Design mockup — working reference, not versioned source.
/ios/FastTabMobile_Redesign_Mockup.html

# Dashboard move (feature/dashboard-move) — dashboard/ is excluded by the
# root "/*" allowlist above; un-ignore it here so its contents can be tracked.
!/dashboard/
/dashboard/ui/node_modules/
/dashboard/ui/dist/
/dashboard/.venv/
# Runtime DB + its auto-exported schema snapshot (chief_dashboard_store.py's
# DEFAULT_DB_PATH/DEFAULT_SCHEMA_PATH) — generated on first run/test, never
# source; mirrors the root /.claude/ ignore rule above for this nested one.
/dashboard/.claude/
__pycache__/
*.pyc
