{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Shared L1 engine, consumed from source (no copy): ~/01_Project/IndieLibKit/ts/table-core
    "paths": { "@indie/table-core": ["../../../IndieLibKit/ts/table-core/src/index.ts"] }
  },
  "include": ["src"]
}
