{
  "manifest_version": 3,
  "name": "FastTab Companion",
  "version": "0.1.3",
  "minimum_chrome_version": "89",
  "description": "Lets the FastTab Mac app read and switch your Chrome tabs instantly, without macOS permission prompts. Requires the FastTab Mac app (fasttab.theindie.app) — this extension does nothing on its own.",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "alarms", "bookmarks", "history"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "key": ""
}
